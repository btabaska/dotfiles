# ~/.zshrc — managed by chezmoi (home/dotfiles). Identical on all machines.
# Machine-specific settings live in ~/.zshrc.local (NOT tracked).

# ---- History ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE INC_APPEND_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# ---- Completion ----
autoload -Uz compinit && compinit -d "$HOME/.zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ---- Prompt (starship) ----
command -v starship >/dev/null && eval "$(starship init zsh)"

# ---- zoxide (smarter cd -> `z` / `zi`) ----
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ---- fzf (ctrl-r history, ctrl-t files, alt-c cd) ----
if command -v fzf >/dev/null; then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    for _f in /opt/homebrew/opt/fzf/shell/key-bindings.zsh /usr/share/fzf/key-bindings.zsh \
              /opt/homebrew/opt/fzf/shell/completion.zsh   /usr/share/fzf/completion.zsh; do
      [ -f "$_f" ] && source "$_f"
    done
    unset _f
  fi
fi

# ---- Modern CLI aliases ----
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lah --group-directories-first --icons=auto --git'
  alias la='eza -a --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --icons=auto'
fi
command -v bat >/dev/null && alias cat='bat --paging=never'

# ---- Machine-specific overrides (untracked) ----
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ---- zsh plugins (installed via brew on macOS, pacman on Arch/CachyOS) ----
# Source whichever path exists. syntax-highlighting MUST be sourced LAST.
for _p in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [ -f "$_p" ] && { source "$_p"; break; }
done
for _p in \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [ -f "$_p" ] && { source "$_p"; break; }
done
unset _p
