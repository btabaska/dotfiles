# Homelab break-glass SSH (net-14) — default key for fleet hosts
Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519_homelab
    IdentitiesOnly yes
    ForwardAgent no
    ServerAliveInterval 30
    ServerAliveCountMax 3

Host github.com
    UseKeychain yes
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host nas
    HostName nas.tailb31641.ts.net
    User btabaska

Host mini server
    HostName macmini.tailb31641.ts.net
    User btabaska

# Wake first: RIG_MAC=... ./scripts/gaming/wake-rig.sh
Host rig
    HostName cachyos.tailb31641.ts.net
    User btabaska
    RequestTTY yes

# Dedicated alias for VSCodium Open Remote-SSH. No forced TTY — RequestTTY yes
# corrupts the remote-server bootstrap handshake. Same host as `rig`.
Host rig-code
    HostName cachyos.tailb31641.ts.net
    User btabaska
    RequestTTY no

Host ha
    HostName homeassistant.tailb31641.ts.net
    User root

Host seedbox
    HostName seedbox.tailb31641.ts.net
    User btabaska

# Forgejo on the mini (self-hosted git) — fixes the broken `forgejo` remote alias
Host forgejo
    HostName macmini.tailb31641.ts.net
    Port 2222
    User git
    IdentityFile ~/.ssh/id_ed25519_homelab
